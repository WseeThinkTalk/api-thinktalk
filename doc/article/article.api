syntax = "v1"

type (
	UploadCoverResponse {
		CoverUrl string `json:"cover_url"`
	}
	PublishRequest {
		Title       string  `json:"title"`
		Content     string  `json:"content"`
		Description string  `json:"description"`
		Cover       string  `json:"cover"`
		TagIds      []int64 `json:"tag_ids,optional"`
	}
	PublishResponse {
		ArticleId int64 `json:"article_id"`
	}
	ArticleDetailRequest {
		ArticleId int64 `form:"article_id,optional"`
	}
	ArticleDetailResponse {
		ArticleId    int64  `json:"article_id"`
		Title        string `json:"title"`
		Content      string `json:"content"`
		Description  string `json:"description"`
		Cover        string `json:"cover"`
		AuthorId     int64  `json:"author_id"`
		AuthorName   string `json:"author_name"`
		AuthorAvatar string `json:"author_avatar"`
		PublishTime  string `json:"publish_time"`
		LikeNum      int64  `json:"like_num"`
	}
	ArticleListRequest {
		AuthorId  int64 `form:"author_id,optional"`
		Cursor    int64 `form:"cursor,optional"`
		PageSize  int64 `form:"page_size,optional"`
		SortType  int32 `form:"sort_type,optional"`
		ArticleId int64 `form:"article_id,optional"`
	}
	ArticleInfo {
		ArticleId   int64  `json:"article_id"`
		Title       string `json:"title"`
		Content     string `json:"content"`
		Description string `json:"description"`
		Cover       string `json:"cover"`
		Status      int64  `json:"status"`
	}
	ArticleListResponse {
		Articles []ArticleInfo `json:"articles"`
	}
	SearchRequest {
		Keyword  string `form:"keyword"`
		Cursor   int64  `form:"cursor"`
		PageSize int64  `form:"page_size"`
	}
	SearchInfo {
		ArticleId    int64  `json:"article_id"`
		Title        string `json:"title"`
		Description  string `json:"description"`
		Cover        string `json:"cover"`
		AuthorId     int64  `json:"author_id"`
		AuthorName   string `json:"author_name"`
		LikeNum      int64  `json:"like_num"`
		CommentNum   int64  `json:"comment_num"`
		PublishTime  string `json:"publish_time"`
		AuthorAvatar string `json:"author_avatar"`
	}
	SearchResponse {
		Articles []SearchInfo `json:"articles"`
		Cursor   int64        `json:"cursor"`
		IsEnd    bool         `json:"is_end"`
	}
	AllArticlesRequest {
		Cursor   int64 `form:"cursor,optional"`
		PageSize int64 `form:"page_size,optional"`
	}
	AllArticlesResponse {
		Articles []SearchInfo `json:"articles"`
		Cursor   int64        `json:"cursor"`
		IsEnd    bool         `json:"is_end"`
	}
	ArticleDeleteRequest {
		ArticleId int64 `json:"article_id"`
	}
	ArticleDeleteResponse {}
	AdminPendingListRequest {
		Cursor   int64 `form:"cursor,optional"`
		PageSize int64 `form:"page_size,optional"`
	}
	AdminPendingListResponse {
		Articles []SearchInfo `json:"articles"`
		Cursor   int64        `json:"cursor"`
		IsEnd    bool         `json:"is_end"`
	}
	AdminAuditRequest {
		ArticleId int64 `json:"article_id"`
		Status    int32 `json:"status"`
	}
	AdminAuditResponse {}
)

@server (
	prefix: /v1/article
	jwt:    Auth
	group:  article
)
service api {
	@handler UploadCoverHandler
	post /upload/cover returns (UploadCoverResponse)

	@handler PublishHandler
	post /publish (PublishRequest) returns (PublishResponse)

	@handler ArticleDetailHandler
	get /detail (ArticleDetailRequest) returns (ArticleDetailResponse)

	@handler ArticleListHandler
	get /list (ArticleListRequest) returns (ArticleListResponse)

	@handler SearchHandler
	get /search (SearchRequest) returns (SearchResponse)

	@handler AllArticlesHandler
	get /all (AllArticlesRequest) returns (AllArticlesResponse)

	@handler ArticleDeleteHandler
	post /delete (ArticleDeleteRequest) returns (ArticleDeleteResponse)
}

@server (
	prefix:     /v1/article/admin
	jwt:        Auth
	middleware: AdminAuth
	group:      article
)
service api {
	@handler AdminPendingListHandler
	get /pending (AdminPendingListRequest) returns (AdminPendingListResponse)

	@handler AdminAuditHandler
	post /audit (AdminAuditRequest) returns (AdminAuditResponse)
}
